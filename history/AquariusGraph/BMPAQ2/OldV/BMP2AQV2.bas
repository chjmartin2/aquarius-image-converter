Dim ret As String

SCREEN 9: CLS
LOCATE 1, 1
FILENAME$ = "-"
TOGGLE = 0

filename$=file_getname(NULL)
SAVENAME$=left(filename$,len(filename$)-4)+".AQ"

rem PRINT "Loading Color Distance Table"

FOR i = 1 TO 16
  FOR j = 1 TO 16
     READ codis(i, j)
     LOCATE 2, 1: PRINT "Index "; i; j
  NEXT j
NEXT i

LOCATE 3, 1

rem PRINT "Loading Color Lookup Table"

FOR i = 1 TO 16

  READ collok(i)
  LOCATE 4, 1: PRINT "Color "; i; collok(i)
NEXT i

for i = 0 to 255
 read lin$
 for j=0 to 7
    for p=0 to 7
      charmap(i,p,j)=val(mid$(lin$,p+j*8+1,1))        
    next p
 next j    
next i

